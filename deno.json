{
  "name": "@decomm/ca",
  "version": "1.0.1",
  "license": "MIT",
  "exports": {
    ".": "./main.ts",
    "./init": "./init.ts"
  },
  "publish": {
    "include": [
      "main.ts",
      "args.ts",
      "cert.ts",
      "pem.ts",
      "store.ts",
      "init.ts",
      "ca.sh",
      "README.md",
      "LICENSE",
      "deno.json",
      "jsr.json"
    ]
  },
  "tasks": {
    "ca": "deno run --allow-read --allow-write --allow-env=CA_DIR main.ts",
    "compile": "mkdir -p bin && deno compile --allow-read --allow-write --allow-env=CA_DIR --output bin/ca main.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net",
    "check": "deno check main.ts args.ts cert.ts pem.ts store.ts init.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@peculiar/x509": "npm:@peculiar/x509@1.14.0"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  }
}
